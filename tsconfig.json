{
    "compilerOptions": {
      "rootDir": "./src",
      "outDir": "./dist",
      "module": "nodenext",
      "target": "esnext",
      "strict": true,
      "sourceMap": true,
      "declaration": true,
      "esModuleInterop": true,
      "allowSyntheticDefaultImports": true,
      "skipLibCheck": true
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist"]
  }